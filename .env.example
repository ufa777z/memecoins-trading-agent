# Required — Helius (never commit real keys; never paste keys in chat)
HELIUS_API_KEY=your_helius_api_key
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# Mode: alerts only, you buy yourself (default)
MANUAL_MODE=true

# Optional Telegram (leave empty for console-only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional CT
GROK_API_KEY=
X_BEARER_TOKEN=
ENABLE_CT_SCANNER=true
NOTIFY_SKIPS=false

# Only needed if MANUAL_MODE=false
DRY_RUN=true
WALLET_PRIVATE_KEY=
