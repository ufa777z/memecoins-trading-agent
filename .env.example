# Required
HELIUS_API_KEY=your_helius_api_key
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# Trading wallet (base58 private key) — use a dedicated low-balance wallet
WALLET_PRIVATE_KEY=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CT / Twitter (optional but recommended)
# Prefer GROK_API_KEY for semantic CT analysis; X_BEARER_TOKEN as fallback
GROK_API_KEY=
X_BEARER_TOKEN=

# Safety — keep true until you have verified logic + wallets
DRY_RUN=true
ENABLE_CT_SCANNER=true
