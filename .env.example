# Required — Helius (never commit real keys)
HELIUS_API_KEY=your_helius_api_key
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# Telegram alerts (recommended for manual mode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MANUAL MODE (default): only alert coins — you buy yourself
# Set to false only if you want the bot to trade (also needs WALLET_PRIVATE_KEY)
MANUAL_MODE=true

# Extra safety if you ever disable MANUAL_MODE
DRY_RUN=true
WALLET_PRIVATE_KEY=

# Optional CT
GROK_API_KEY=
X_BEARER_TOKEN=
ENABLE_CT_SCANNER=true

# Set true to also Telegram every skipped token (noisy)
NOTIFY_SKIPS=false
